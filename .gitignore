# Build output (raw image, zstd, checksum)
dist/

# PVE test output (screenshots, downloaded assets)
.github/pve/out/

# Vendored binaries downloaded at build time (not committed)
build/vendor/app-runner
build/vendor/app-runner.exe
build/vendor/apk.static
build/vendor/fbterm-src.tar.gz
# User private SSH key - delivered to user directly, never committed
build/vendor/ssh_user_key

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Local PVE credentials (never commit)
.pve/

# Python bytecode
__pycache__/
*.pyc
# Host private SSH key - lives in the SSH_HOST_ED25519_KEY secret, never committed
build/vendor/ssh_host_ed25519_key
