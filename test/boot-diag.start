#!/bin/sh
# Boot-time diagnostic persisted by the guest so the KVM test can inspect
# network / display / process state after the VM is shut down.
# Spawned via inittab (::respawn) so it runs regardless of OpenRC runlevel
# progress -- a blocked networking service must not hide the evidence.
# Only injected by the test workflow (test-boot.yml), never shipped in
# production images.
[ -f /var/log/boot-diag.done ] && exit 0
sleep 8
mkdir -p /var/log 2>/dev/null
{
  echo "=== boot-diag $(date -u +%s) ==="
  echo "--- ifconfig ---"; ifconfig -a 2>&1
  echo "--- netdev ---"; cat /proc/net/dev 2>&1
  echo "--- fb ---"; ls -la /dev/fb* 2>&1
  echo "--- ps ---"; ps 2>&1 | grep -iE 'app-runner|fbterm|business' 2>&1
  echo "--- applog ---"; cat /var/log/app-runner.log 2>&1
  echo "--- resolv ---"; cat /etc/resolv.conf 2>&1
  echo "--- lsmod ---"; lsmod 2>&1
  echo "--- dmesg ---"; dmesg 2>&1 | tail -50
  echo "--- runlevel ---"; rc-status --all 2>&1 | tail -40
  echo "=== end diag ==="
} > /var/log/boot-diag.log 2>&1
touch /var/log/boot-diag.done
exit 0
