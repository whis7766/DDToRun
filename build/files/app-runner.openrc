#!/sbin/openrc-run
# shellcheck disable=SC2034  # settings consumed by openrc-run, not by this file
description="Download and run the business application"

APP=/opt/business-app
supervisor=supervise-daemon
command=/usr/local/sbin/app-runner
environment="APP_RUNNER_LOG_STDOUT_ONLY=1"
command_user=root
pidfile=/run/app-runner.pid
output_log=/var/log/app-runner.log
error_log=/var/log/app-runner.log

depend() {
	need net
	after time-sync
	# Soft dependency: ordered after sshd when it exists (headless), ignored
	# in the kiosk profile where sshd is not installed.
	use sshd
}

pre_start() {
	# Same path as app-runner's appPath; kill a stale process so the replacement
	# can bind its ports.
	pkill -f "^$APP" 2>/dev/null || true
}
