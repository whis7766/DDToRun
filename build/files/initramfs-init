#!/bin/sh
# Minimal initramfs init.
#
# The stock Alpine init hands off to nlplug-findfs, which is built against
# libcryptsetup and therefore drags the whole OpenSSL/device-mapper stack into
# the initramfs; the stock base feature additionally ships /sbin/apk, which
# pulls libcrypto in on its own. This appliance never uses encrypted or LVM
# roots, so this replacement keeps the same boot contract - resolve the root
# device, mount it read-only, switch_root - using only busybox.
#
# Device discovery replays the kernel device tree (mdev -s); mdev.conf
# modprobes each MODALIAS, the same coldplug mechanism Alpine uses for
# diskless boot.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# --- base filesystems -----------------------------------------------------
# The applet symlinks are not installed yet, so every call is explicit.
[ -c /dev/null ] || busybox mknod -m 666 /dev/null c 1 3
busybox mount -t sysfs -o noexec,nosuid,nodev sysfs /sys
busybox mount -t devtmpfs -o exec,nosuid,mode=0755 devtmpfs /dev 2>/dev/null ||
	busybox mount -t tmpfs -o exec,nosuid,mode=0755 tmpfs /dev
[ -c /dev/kmsg ] || busybox mknod -m 660 /dev/kmsg c 1 11
busybox mount -t proc -o noexec,nosuid,nodev proc /proc

# busybox --install needs these directories to exist before linking applets.
busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /dev/pts /dev/shm
busybox --install -s

mount -t devpts -o gid=5,mode=0620,noexec,nosuid devpts /dev/pts
mount -t tmpfs -o nodev,nosuid,noexec shm /dev/shm

# --- kernel command line --------------------------------------------------
for _opt in $(cat /proc/cmdline); do
	case "$_opt" in
	root=*) KOPT_root="${_opt#root=}" ;;
	rootflags=*) KOPT_rootflags="${_opt#rootflags=}" ;;
	rootfstype=*) KOPT_rootfstype="${_opt#rootfstype=}" ;;
	modules=*) KOPT_modules="${_opt#modules=}" ;;
	init=*) KOPT_init="${_opt#init=}" ;;
	esac
done

# --- coldplug -------------------------------------------------------------
# Register mdev for asynchronous events, then load the storage stack
# deterministically: mdev's MODALIAS replay alone does not reliably bind a
# virtio-scsi root in time. Both virtio-scsi and virtio-blk are seeded; mdev -s
# then creates the nodes and fills any remaining gap (net/drm).
echo /sbin/mdev >/proc/sys/kernel/hotplug
_mods=$(printf '%s' "$KOPT_modules" | tr ',' ' ')
for _mod in $_mods loop virtio virtio_ring virtio_pci virtio_mmio virtio_scsi \
	sd_mod virtio_blk ext4 jbd2 mbcache; do
	busybox modprobe -q "$_mod" 2>/dev/null
done
busybox mdev -s
# Retry once after the replay, in case a dependency only appeared during mdev -s.
busybox modprobe -a virtio_scsi sd_mod virtio_blk ext4 2>/dev/null

# --- resolve the root device ----------------------------------------------
case "$KOPT_root" in
UUID=* | LABEL=*) root_dev="" ;;
*) root_dev="$KOPT_root" ;;
esac

_i=0
while [ "$_i" -lt 150 ]; do
	[ -n "$root_dev" ] || root_dev=$(findfs "$KOPT_root" 2>/dev/null)
	[ -n "$root_dev" ] && [ -b "$root_dev" ] && break
	sleep 0.2
	_i=$((_i + 1))
done

if [ -z "$root_dev" ] || [ ! -b "$root_dev" ]; then
	echo "initramfs: root device '$KOPT_root' not found" >/dev/kmsg
	echo "--- loaded modules ---"
	cat /proc/modules
	echo "--- block devices ---"
	ls -l /dev/sd* /dev/vd* 2>/dev/null
	echo "--- findfs result ---"
	findfs "$KOPT_root" 2>&1
	echo "emergency recovery shell. Type 'exit' to retry."
	busybox sh
fi

# --- mount the real root read-only ----------------------------------------
mkdir -p /sysroot
_mount_opts=ro
[ -n "$KOPT_rootflags" ] && _mount_opts="$KOPT_rootflags,ro"

if [ -n "$KOPT_rootfstype" ]; then
	mount -t "$KOPT_rootfstype" -o "$_mount_opts" "$root_dev" /sysroot
else
	mount -o "$_mount_opts" "$root_dev" /sysroot
fi

if [ $? -ne 0 ]; then
	echo "initramfs: failed to mount root" >/dev/kmsg
	busybox sh
fi

_init_path="/sysroot${KOPT_init:-/sbin/init}"
if [ ! -x "$_init_path" ]; then
	echo "initramfs: ${KOPT_init:-/sbin/init} missing in new root" >/dev/kmsg
	busybox sh
fi

# --- hand over to the real system -----------------------------------------
# shellcheck disable=SC2093  # the lines below are the emergency path when exec fails
exec switch_root /sysroot "${KOPT_init:-/sbin/init}"
echo "initramfs: switch_root failed" >/dev/kmsg
busybox sh
